-- DATABASE: layoutDB
-- ===============================
COMMENT ON DATABASE "layoutDB" IS 'Stores dashboard layout configurations';

-- Create table for saving dashboard layouts
CREATE TABLE IF NOT EXISTS saved_layouts (
  id SERIAL PRIMARY KEY,
  "layoutName" VARCHAR(255) NOT NULL,
  widgets JSONB NOT NULL DEFAULT '[]',
  "createdAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  "updatedAt" TIMESTAMP NOT NULL DEFAULT NOW()
);

-- Indexes for faster search
CREATE INDEX idx_layout_name ON saved_layouts("layoutName");
CREATE INDEX idx_created_at ON saved_layouts("createdAt");    



-- ===============================
-- DATABASE: salesDB
-- ===============================
COMMENT ON DATABASE "salesDB" IS 'Sales data for widgets';

-- Trigger function to notify data changes
CREATE OR REPLACE FUNCTION notify_table_change()
RETURNS TRIGGER AS $$
DECLARE
  payload JSON;
BEGIN
  payload = json_build_object(
    'table', TG_TABLE_NAME,
    'operation', TG_OP,
    'data', row_to_json(COALESCE(NEW, OLD))
  );
  
  PERFORM pg_notify('table_change', payload::text);
  RETURN NULL;
END;
$$ LANGUAGE plpgsql;

-- Create branchstats table
CREATE TABLE IF NOT EXISTS branchstats (
  id SERIAL PRIMARY KEY,
  branch VARCHAR(255) NOT NULL,
  "NofEmployee" INTEGER,
  "NofIntern" INTEGER,
  "createdAt" TIMESTAMP DEFAULT NOW(),
  "updatedAt" TIMESTAMP DEFAULT NOW()
);

-- Create sales table
CREATE TABLE IF NOT EXISTS sales (
  id SERIAL PRIMARY KEY,
  branch VARCHAR(255),
  amount DECIMAL(10, 2),
  date DATE,
  "createdAt" TIMESTAMP DEFAULT NOW()
);

-- Create revenue table
CREATE TABLE IF NOT EXISTS revenue (
  id SERIAL PRIMARY KEY,
  branch VARCHAR(255),
  revenue DECIMAL(10, 2),
  month VARCHAR(50),
  year INTEGER,
  "createdAt" TIMESTAMP DEFAULT NOW()
);

-- Create triggers for live change notifications
CREATE TRIGGER branchstats_notify
AFTER INSERT OR UPDATE OR DELETE ON branchstats
FOR EACH ROW EXECUTE FUNCTION notify_table_change();

CREATE TRIGGER sales_notify
AFTER INSERT OR UPDATE OR DELETE ON sales
FOR EACH ROW EXECUTE FUNCTION notify_table_change();

CREATE TRIGGER revenue_notify
AFTER INSERT OR UPDATE OR DELETE ON revenue
FOR EACH ROW EXECUTE FUNCTION notify_table_change();

